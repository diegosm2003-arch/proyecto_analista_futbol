# Copiar a .env y ajustar. .env NUNCA se sube a Git.

# --- PostgreSQL ---
POSTGRES_USER=futbol
POSTGRES_PASSWORD=cambiar_esta_password
POSTGRES_DB=futbol
# Dentro de Docker el host es "postgres"; docker-compose ya lo fija por servicio.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Puertos publicados en el host ---
POSTGRES_HOST_PORT=5432
API_HOST_PORT=8000
APP_HOST_PORT=8501
OLLAMA_HOST_PORT=11434

# --- API ---
# Dentro de Docker el servicio se llama "backend"; el compose ya lo fija en
# el frontend. Solo hace falta cambiarlo para ejecutar fuera de contenedores.
API_BASE_URL=http://backend:8000

# --- Datos ---
# Poblacion de referencia para los percentiles (las Big 5), separada por comas.
LEAGUES=ESP-La Liga,ENG-Premier League,ITA-Serie A,GER-Bundesliga,FRA-Ligue 1
# Temporadas en formato corto de soccerdata: 2627 = 2026/27. Si se deja sin
# definir, se usa la temporada en curso, calculada a partir de la fecha.
# SEASONS=2627
# Minutos minimos para entrar en la poblacion de percentiles.
MIN_MINUTES=450
# Con la temporada empezada el umbral baja a esta fraccion de los minutos del
# jugador que mas ha jugado, para que la plataforma no salga vacia en
# septiembre. Con la temporada terminada no cambia nada.
MIN_MINUTES_RATIO=0.3
# Cache del scraping. Dentro del contenedor apunta al volumen ./data.
SOCCERDATA_DIR=/app/data/soccerdata

# --- Planificacion del ETL (perfil "scheduler") ---
# Martes y jueves a las 6:00. Las estadisticas solo cambian tras una jornada, y
# FBref limita a una peticion cada 7 segundos: cargar a diario seria castigarlo
# para nada.
# Los dias van por nombre: APScheduler numera 0 = lunes y el cron clasico
# 0 = domingo, asi que "2,4" cargaria miercoles y viernes.
ETL_SCHEDULE=0 6 * * tue,thu
SCHEDULE_TIMEZONE=Europe/Madrid
# Cargar nada mas arrancar el planificador, sin esperar al martes.
ETL_RUN_ON_START=false

# --- Ollama (opcional) ---
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b

# --- Logging ---
LOG_LEVEL=INFO
