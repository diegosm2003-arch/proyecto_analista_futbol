# Copiar a .env y ajustar. .env NUNCA se sube a Git.

# --- PostgreSQL ---
POSTGRES_USER=futbol
POSTGRES_PASSWORD=cambiar_esta_password
POSTGRES_DB=futbol
# Dentro de Docker el host es "postgres"; docker-compose ya lo fija por servicio.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Puertos publicados en el host ---
# 5433 y no 5432: muchas maquinas ya tienen un PostgreSQL propio instalado
# como servicio, y entonces el ETL lanzado desde el host se conecta a ese en
# lugar de al contenedor. Falla con un error de contrasena que despista.
POSTGRES_HOST_PORT=5433
API_HOST_PORT=8000
APP_HOST_PORT=8501
OLLAMA_HOST_PORT=11434

# --- API ---
# Dentro de Docker el servicio se llama "backend"; el compose ya lo fija en
# el frontend. Solo hace falta cambiarlo para ejecutar fuera de contenedores.
API_BASE_URL=http://backend:8000

# --- Datos ---
# Poblacion de referencia para los percentiles (las Big 5), separada por comas.
LEAGUES=ESP-La Liga,ENG-Premier League,ITA-Serie A,GER-Bundesliga,FRA-Ligue 1
# Temporadas en formato corto de soccerdata: 2627 = 2026/27. Si se deja sin
# definir, se usa la temporada en curso, calculada a partir de la fecha.
# SEASONS=2627
# Minutos minimos para entrar en la poblacion de percentiles.
MIN_MINUTES=450
# Con la temporada empezada el umbral baja a esta fraccion de los minutos del
# jugador que mas ha jugado, para que la plataforma no salga vacia en
# septiembre. Con la temporada terminada no cambia nada.
MIN_MINUTES_RATIO=0.3
# FBref publica una pagina con las cinco grandes ligas juntas: pedir esa en
# lugar de las cinco por separado da los mismos datos con una quinta parte de
# peticiones. Solo desactivar si esa pagina se desincronizase.
USE_COMBINED_BIG5=true
# Cache del scraping. Dentro del contenedor apunta al volumen ./data.
SOCCERDATA_DIR=/app/data/soccerdata

# --- Planificacion del ETL (perfil "scheduler") ---
# Martes y jueves a las 6:00. Las estadisticas solo cambian tras una jornada, y
# Cargar a diario multiplicaria por siete las peticiones a Understat para uno o
# dos cambios reales.
# Los dias van por nombre: APScheduler numera 0 = lunes y el cron clasico
# 0 = domingo, asi que "2,4" cargaria miercoles y viernes.
ETL_SCHEDULE=0 6 * * tue,thu
SCHEDULE_TIMEZONE=Europe/Madrid
# Cargar nada mas arrancar el planificador, sin esperar al martes.
ETL_RUN_ON_START=false

# --- Transfermarkt (perfil "transfermarkt") ---
TRANSFERMARKT_URL=http://transfermarkt-api:8000
# Un valor de mercado se revisa cada pocos meses. Treinta dias, no siete: con la
# carga programada cada sabado, una ventana de una semana volveria a descargar
# la liga entera en cada ejecucion para traer un dato que cambia trimestralmente.
TRANSFERMARKT_FRESHNESS_HOURS=720
# Parecido minimo para dar por bueno un cruce por nombre.
FUZZY_MATCH_THRESHOLD=85
# Cadencia de la carga de valor de mercado. Otro dia que el ETL a proposito: esa
# carga lee player_season para saber a quien buscar, y hacerlo mientras el ETL
# reescribe la tabla daria una plantilla a medias. Vacio para no programarla.
TRANSFERMARKT_SCHEDULE=0 5 * * sat

# --- Ollama (opcional) ---
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b

# --- Logging ---
LOG_LEVEL=INFO
